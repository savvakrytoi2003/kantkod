# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL (host "postgres" inside docker compose, "localhost" for local run) ---
DATABASE_URL=postgresql+asyncpg://kantkod:kantkod@postgres:5432/kantkod

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Source: "Work in Russia" open data API ---
SOURCE_API_URL=http://opendata.trudvsem.ru/api/v1/vacancies/region/39
SOURCE_REGION=39
SOURCE_MAX_VACANCIES=100
SOURCE_PAGE_SIZE=50
SOURCE_TIMEOUT=30
SOURCE_MAX_RETRIES=3

# --- Synchronization schedule ---
SYNC_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=true

# --- AI provider (OpenAI compatible API) ---
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
# DeepSeek: без reasoning — быстрее и дешевле для JSON-анализа
AI_THINKING=false
AI_BATCH_SIZE=20
AI_MAX_CONCURRENCY=3
AI_TIMEOUT=180
AI_MAX_RETRIES=3
AI_ENABLED=true

# --- Reports & cache ---
REPORTS_DIR=reports
CACHE_TTL_SECONDS=600
